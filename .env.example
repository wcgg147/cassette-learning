# 会话磁带 · 开源包配置模板
# 用法：cp .env.example .env，按需填值。后端读 backend/app/.env，
#       语音代理读 voice/.env（两边各放一份，或直接用环境变量）。
#
# ⛔ 别把真 key 写进仓库里。.env 已在 .gitignore 中。
# 这个文件里所有 key 字段都是**空占位**，仓库不含任何私人凭据。

# ── 后端（backend/app）────────────────────────────────────
# 开源包只有一种记忆后端：local（SQLite + JSON，零外部服务）。
MEMORY_BACKEND=local
APP_ENV=development
API_PORT=8002

# 设备身份登录：前端首次运行会生成随机 UUID 作为设备身份。
# 本包没有微信小程序 AppID/Secret，必须开这个开关，否则 /auth/wx_login 会 500。
# 生产环境请换成真实登录并关掉。
WX_DEV_MODE=1

# 回复模型（四盘的"大脑"）。走 OpenAI 兼容协议：填 base_url + key + model。
# 不填时回复链路会走兜底并重试约 1 分钟；建盘/素材/词块等纯代码功能不受影响。
TUTOR_RESPONSE_BASE_URL=
TUTOR_RESPONSE_API_KEY=
TUTOR_RESPONSE_MODEL=
TUTOR_RESPONSE_MAX_TOKENS=900

# 会话导演（默认开；缺 key 时自动退化为本地决策）
CONVERSATION_DIRECTOR_ENABLED=true
CONVERSATION_DIRECTOR_BASE_URL=
CONVERSATION_DIRECTOR_API_KEY=
CONVERSATION_DIRECTOR_MODEL=

# 联网检索（默认关）
CONVERSATION_DIRECTOR_WEB_SEARCH_ENABLED=false

# ── 语音代理（voice/）─────────────────────────────────────
# 两个语音 key 都留空 = 纯文本模式：四盘 HTTP 功能全可用，只是没有 ASR/TTS。
# 想开语音，任选一家填 key 并设好 VOICE_TRANSPORT 后重启代理。
VOICE_TRANSPORT=doubao
DASHSCOPE_API_KEY=
DOUBAO_VOICE_API_KEY=

DEMO_SESSION_PORT=3211
BACKEND_API_HOST=127.0.0.1
BACKEND_API_PORT=8002
BACKEND_API_PROTOCOL=http:
DOUBAO_SPEAKER_EN=en_female_dacey_uranus_bigtts

# 不设置时按系统 PATH 找 ffmpeg；Windows 可在 .env 里钉绝对路径
FFMPEG_BIN=
